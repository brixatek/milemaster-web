# Public base URL used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://milemasterintegrated.com

# Enquiry email delivery via Resend (https://resend.com). Leave blank to disable;
# forms then show an honest "unavailable — contact us directly" message.
RESEND_API_KEY=
# Comma-separated recipients for enquiries.
ENQUIRY_TO_EMAIL=info@milemasterintegrated.com
# Verified sender on your Resend domain.
ENQUIRY_FROM_EMAIL=Website <no-reply@milemasterintegrated.com>
